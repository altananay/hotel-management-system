# =============================================================================
# LOCAL DEVELOPMENT DEFAULTS ONLY — NOT REAL SECRETS (docs/conventions.md §2.4)
# Copy to .env in the repository root for local overrides. Never commit production values.
#
# How this file is read (see infra/README.md):
#   - Docker Compose: docker compose --env-file .env -f infra/docker-compose.yml ...
#   - Spring apps: only with the "local" profile (application-local.yml imports the root .env)
#   - Maven/Flyway CLI: does NOT read .env; use -D overrides
#   - Frontends (web, admin-web): do NOT read this file; copy values to
#     web/.env.local / admin-web/.env.local or export them in the process environment
# =============================================================================

# --- Infrastructure (infra/docker-compose.yml) ---
POSTGRES_SUPERUSER=postgres
# LOCAL DEV DEFAULT — NOT A SECRET
POSTGRES_SUPERUSER_PASSWORD=postgres_local_dev
# If you change POSTGRES_PORT, also update HOTEL_CORE_DB_URL and HOTEL_ADMIN_DB_URL
POSTGRES_PORT=5432

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
# LOCAL DEV DEFAULT — NOT A SECRET
MINIO_ROOT_PASSWORD=minioadmin_local_dev
MINIO_BUCKET_MEDIA=hotel-media

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- backend/hotel-api (:8081) — Spring (local profile) ---
HOTEL_API_PORT=8081
HOTEL_CORE_DB_URL=jdbc:postgresql://localhost:5432/hotel_core
# Role credentials are fixed local defaults created by
# infra/postgres/init/01-init-roles-and-dbs.sql (app / app_local_dev);
# change them there and recreate the volume (docker compose down -v).
HOTEL_CORE_DB_USER=app
# LOCAL DEV DEFAULT — NOT A SECRET
HOTEL_CORE_DB_PASSWORD=app_local_dev
HOTEL_API_CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- backend/admin-api (:8082) — Spring (local profile) ---
ADMIN_API_PORT=8082
HOTEL_ADMIN_DB_URL=jdbc:postgresql://localhost:5432/hotel_admin
HOTEL_ADMIN_DB_USER=app
# LOCAL DEV DEFAULT — NOT A SECRET
HOTEL_ADMIN_DB_PASSWORD=app_local_dev
ADMIN_API_UPSTREAM_HOTEL_API_URL=http://localhost:8081

# --- web (:3000) — Next.js reads web/.env.local or the process environment ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081
# Canonical/OG absolute URL base for metadata (defaults to http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- admin-web (:3001) — Next.js reads admin-web/.env.local or the process environment ---
ADMIN_API_INTERNAL_URL=http://localhost:8082
