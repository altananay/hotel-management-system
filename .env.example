# =============================================================================
# LOCAL DEVELOPMENT DEFAULTS ONLY — NOT REAL SECRETS (docs/conventions.md §2.4)
# Copy to .env for local overrides if needed. Never commit production values.
# =============================================================================

# --- Infrastructure (infra/docker-compose.yml) ---
POSTGRES_SUPERUSER=postgres
# LOCAL DEV DEFAULT — NOT A SECRET
POSTGRES_SUPERUSER_PASSWORD=postgres_local_dev
POSTGRES_PORT=5432

DB_MIGRATOR_USER=migrator
# LOCAL DEV DEFAULT — NOT A SECRET
DB_MIGRATOR_PASSWORD=migrator_local_dev

DB_APP_USER=app
# LOCAL DEV DEFAULT — NOT A SECRET
DB_APP_PASSWORD=app_local_dev

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
# LOCAL DEV DEFAULT — NOT A SECRET
MINIO_ROOT_PASSWORD=minioadmin_local_dev
MINIO_BUCKET_MEDIA=hotel-media

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- backend/hotel-api (:8081) ---
HOTEL_API_PORT=8081
HOTEL_CORE_DB_URL=jdbc:postgresql://localhost:5432/hotel_core
HOTEL_CORE_DB_USER=app
# LOCAL DEV DEFAULT — NOT A SECRET
HOTEL_CORE_DB_PASSWORD=app_local_dev
HOTEL_CORE_MIGRATOR_USER=migrator
# LOCAL DEV DEFAULT — NOT A SECRET
HOTEL_CORE_MIGRATOR_PASSWORD=migrator_local_dev
HOTEL_API_CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- backend/admin-api (:8082) ---
ADMIN_API_PORT=8082
HOTEL_ADMIN_DB_URL=jdbc:postgresql://localhost:5432/hotel_admin
HOTEL_ADMIN_DB_USER=app
# LOCAL DEV DEFAULT — NOT A SECRET
HOTEL_ADMIN_DB_PASSWORD=app_local_dev
HOTEL_ADMIN_MIGRATOR_USER=migrator
# LOCAL DEV DEFAULT — NOT A SECRET
HOTEL_ADMIN_MIGRATOR_PASSWORD=migrator_local_dev
ADMIN_API_UPSTREAM_HOTEL_API_URL=http://localhost:8081

# --- web (:3000) ---
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081

# --- admin-web (:3001) ---
ADMIN_WEB_PORT=3001
ADMIN_API_INTERNAL_URL=http://localhost:8082
